# Discord Webhook URL
DISCORD_WEBHOOK_URL=""

# CMMA API エンドポイント
CMMA_VOLATILITY_API_URL="https://stg.api.1btc.love/volatility"

# --- API クエリパラメータ ---
# 分析対象の時間足 (例: 1m, 5m, 1h, 4h, 1d)
TIMEFRAME="4h"
# 価格変動の閾値（パーセンテージ、例: 5.0で5%）
THRESHOLD="5.0"
# 何本前のローソク足と比較するか (例: 1で1本前のローソク足と比較)
OFFSET="1"
# 変動方向 ('up': 上昇, 'down': 下落, 'both': 両方)
DIRECTION="up"
# ソート順 ('volatility_desc': 変動率降順, 'volatility_asc': 変動率昇順, 'symbol_asc': シンボル名昇順)
CMMA_VOLATILITY_API_SORT="volatility_desc"
# APIから取得する最大結果数
CMMA_VOLATILITY_API_LIMIT="100"

# --- 通知設定 ---
# 1つのDiscordメッセージで送信する最大通知数
MAX_NOTIFICATIONS="20"
# 同一トークン/変動範囲に対して再通知を行うまでの待機時間（分）
RENOTIFY_BUFFER_MINUTES="240"
# チェックサイクル間の間隔（秒）
CHECK_INTERVAL_SECONDS="300"

# --- Discordメッセージ保持設定 ---
# チャンネルに残す最新メッセージ数 (超過分は古いものからwebhook経由で削除)
DISCORD_KEEP_MESSAGES="50"
# 古いメッセージの削除処理を実行する間隔（時間）
DISCORD_CLEANUP_INTERVAL_HOURS="24"
# 削除APIの呼び出し間隔（秒、レート制限対策）
DISCORD_DELETE_INTERVAL_SECONDS="0.5"

# --- 出来高フィルター設定 (オプショナル) ---
# 出来高の閾値（この値より大きい出来高を持つ銘柄のみ通知される。0または未設定の場合は無効）
VOLUME_THRESHOLD="1000000.0"
# 出来高取得APIのエンドポイント
CMMA_VOLUME_API_URL="https://stg.api.1btc.love/volume"
# 出来高分析対象の時間足 (例: 1m, 5m, 1h, 4h, 1d)
VOLUME_TIMEFRAME="1h"
# 出来高分析対象の期間 (例: 24h, 7d)
VOLUME_PERIOD="24h"
# 出来高APIのソート順 ('turnover_desc': 出来高降順, 'turnover_asc': 出来高昇順)
CMMA_VOLUME_API_SORT="turnover_desc"
# 出来高APIから取得する最大結果数
CMMA_VOLUME_API_LIMIT="100"


# --- ログ設定 ---
# クリーンアップが実行されるログディレクトリの最大サイズ（MB）
LOG_MAX_SIZE_MB="10"
# Optional message lifetime in hours; 0 keeps the existing count-only policy.
DISCORD_MESSAGE_MAX_AGE_HOURS=0
